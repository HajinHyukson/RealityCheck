{"stage": "completed", "event": "R01-D01", "attributions": 4, "covenant_assessments": [{"clause_id": "C01", "status": "insufficient_evidence", "rationale": "The event provides cash and inventory figures but does not disclose receivables, which are required to calculate Consolidated Core Assets for the Minimum Core Assets Test.", "evidence": [{"document_id": "IRBT-PR-2023-11-07", "locator": "P0023", "quote": "\u2022The Company's inventory balance was $244.5 million as of September 30, 2023, compared with $285.3 million at the end of 2022. GAAP days in inventory (DII) was 161 days, compared with 95 days at the end of 2022.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C02", "status": "compliant", "rationale": "The press release announcing Q3 results on November\u202f7 indicates the company delivered its quarterly financial statements on time, satisfying the reporting duty under Section\u202f6.01.", "evidence": [{"document_id": "IRBT-PR-2023-11-07", "locator": "P0013", "quote": "BEDFORD, Mass., November 7, 2023 \u2013 iRobot Corp. (NASDAQ: IRBT), a leader in consumer robots, today announced its financial results for the third quarter ended September 30, 2023.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C03", "status": "insufficient_evidence", "rationale": "No monthly compliance certificate or related data is disclosed in the event, so compliance with the monthly deliverables required by Section\u202f6.02(a) cannot be assessed.", "evidence": [{"document_id": "IRBT-PR-2023-11-07", "locator": "P0013", "quote": "BEDFORD, Mass., November 7, 2023 \u2013 iRobot Corp. (NASDAQ: IRBT), a leader in consumer robots, today announced its financial results for the third quarter ended September 30, 2023.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C04", "status": "not_triggered", "rationale": "The event shows an Amazon merger amendment and stockholder approval, not termination; the break\u2011fee sweep only triggers if the acquisition is not consummated **and** the agreement is terminated.", "evidence": [{"document_id": "IRBT-PR-2023-11-07", "locator": "P0033", "quote": "On July 24, 2023, iRobot entered into a $200 million financing facility to fund its ongoing operations. At the same time, iRobot and Amazon amended the existing terms of their merger agreement to reflect a reduction in the price per share. For Amazon, the change in price per share is expected to be largely offset by the increase in iRobot's net debt under the new financing facility. On October 12, 2023, iRobot's stockholders approved and adopted the amended merger agreement at the Company's special meeting of stockholders.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C05", "status": "not_triggered", "rationale": "The event contains no mention of any default or event of default, so the notice duty under Section\u202f6.03(a) remains inactive.", "evidence": [{"document_id": "IRBT-PR-2023-11-07", "locator": "P0013", "quote": "BEDFORD, Mass., November 7, 2023 \u2013 iRobot Corp. (NASDAQ: IRBT), a leader in consumer robots, today announced its financial results for the third quarter ended September 30, 2023.", "verified": true}], "interpretation": "model", "package_version": "1.0"}], "warnings": []}
