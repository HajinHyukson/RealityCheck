{"stage": "completed", "event": "R01-D06", "attributions": 3, "covenant_assessments": [{"clause_id": "C01", "status": "insufficient_evidence", "rationale": "The event reports cash ($99.4\u202fM), restricted cash ($41.1\u202fM) and inventory ($149.2\u202fM) but omits accounts receivable, preventing calculation of Consolidated Core Assets for the Minimum Core Assets Test.", "evidence": [{"document_id": "IRBT-PR-2024-11-06", "locator": "P0035", "quote": "\u2022As of September 28, 2024, the Company\u2019s cash and cash equivalents totaled $99.4 million, compared with $108.5 million as of the end of the second quarter of 2024.", "verified": true}, {"document_id": "IRBT-PR-2024-11-06", "locator": "P0035", "quote": "The Company also had an additional $41.1 million restricted cash set aside for future repayment of its term loan, subject to limited rights for inventory purchases, of which $40.0 million was drawn down at the close of the third quarter and received in the fourth quarter.", "verified": true}, {"document_id": "IRBT-PR-2024-11-06", "locator": "P0036", "quote": "\u2022As of September 28, 2024, the Company\u2019s inventory totaled $149.2 million, compared with $244.5 million as of the end of the third quarter of 2023.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C02", "status": "compliant", "rationale": "The press release announcing Q3 2024 results on November\u202f6,\u202f2024 demonstrates timely delivery of quarterly financial statements as required.", "evidence": [{"document_id": "IRBT-PR-2024-11-06", "locator": "P0015", "quote": "BEDFORD, Mass., November 6, 2024 - iRobot Corp. (NASDAQ: IRBT), a leader in consumer robots, today announced its financial results for the third quarter ended September 28, 2024.", "verified": true}], "interpretation": "model", "package_version": "1.0"}], "warnings": ["Attribution 1 withheld: evidence citation did not verify at its document and locator.", "Attribution 4 withheld: evidence c