{"stage": "completed", "event": "R01-D02", "attributions": 1, "covenant_assessments": [{"clause_id": "C01", "status": "insufficient_evidence", "rationale": "Event confirms receipt of Amazon Break Fee exceeding $24M, triggering the Minimum Core Assets Test reduction provision, but lacks public Consolidated Core Assets data to assess compliance.", "evidence": [{"document_id": "IRBT-PR-2024-01-29", "locator": "P0045", "quote": "Under the terms of the merger agreement, Amazon will pay iRobot a $94 million termination fee. After payment of financial advisor fees of approximately 20% of the termination fee, the Company shall apply $35 million dollars of the termination fee immediately to repay the term loan and the remainder of the termination fee will be set aside to be used for future repayments of the term loan subject to limited rights of the Company to utilize such amounts for the purchase of inventory.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C02", "status": "insufficient_evidence", "rationale": "Event provides no information on delivery of annual, quarterly, or budget financial statements or going-concern assessments, so compliance with Section 6.01 cannot be determined.", "evidence": [{"document_id": "IRBT-PR-2024-01-29", "locator": "P0011", "quote": "iRobot Announces Operational Restructuring Plan to Position Company for the Future", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C03", "status": "insufficient_evidence", "rationale": "Event does not address monthly financial deliverables or Compliance Certificate timing, leaving Section 6.02(a) compliance unverified.", "evidence": [{"document_id": "IRBT-PR-2024-01-29", "locator": "P0011", "quote": "iRobot Announces Operational Restructuring Plan to Position Company for the Future", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C04", "status": "compliant", "rationale": "Event states Amazon will pay $94M termination fee, with $35M immediately applied to repay the Term Loan, satisfying the Initial Break Fee Payment requirement of Section 2.05(b)(iv); the remainder is set aside for future repayments and limited inventory use, consistent with the sweep provisions.", "evidence": [{"document_id": "IRBT-PR-2024-01-29", "locator": "P0045", "quote": "Under the terms of the merger agreement, Amazon will pay iRobot a $94 million termination fee. After payment of financial advisor fees of approximately 20% of the termination fee, the Company shall apply $35 million dollars of the termination fee immediately to repay the term loan and the remainder of the termination fee will be set aside to be used for future repayments of the term loan subject to limited rights of the Company to utilize such amounts for the purchase of inventory.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C05", "status": "insufficient_evidence", "rationale": "Event contains no notice of default or event of default, so Section 6.03(a) obligations cannot be evaluated.", "evidence": [{"document_id": "IRBT-PR-2024-01-29", "locator": "P0011", "quote": "iRobot Announces Operational Restructuring Plan to Position Company for the Future", "verified": true}], "interpretation": "model", "package_version": "1.0"}], "warnings": []}
