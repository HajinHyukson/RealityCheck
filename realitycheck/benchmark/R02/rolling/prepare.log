{"stage": "completed", "event": "R02-D02", "attributions": 3, "covenant_assessments": [{"clause_id": "C01", "status": "insufficient_evidence", "rationale": "Public data provide only quarterly Adjusted EBITDA and total debt; Consolidated EBITDA and net debt needed for the leverage ratio are not disclosed, preventing calculation of the ratio versus the 4.25 limit.", "evidence": [{"document_id": "RMBL-PR-2023-05-10", "locator": "P0046", "quote": "Adjusted EBITDA was $10.7 million, compared to $18.7 million.", "verified": true}, {"document_id": "RMBL-PR-2023-05-10", "locator": "P0047", "quote": "Cash and Restricted Cash as of March 31, 2023 was approximately $61.8 million, and total debt was $376.8 million.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C02", "status": "insufficient_evidence", "rationale": "Senior secured net leverage requires Consolidated EBITDA and secured debt details that are not publicly disclosed; the available Adjusted EBITDA and total debt figures are insufficient to assess compliance with the 3.75 limit.", "evidence": [{"document_id": "RMBL-PR-2023-05-10", "locator": "P0046", "quote": "Adjusted EBITDA was $10.7 million, compared to $18.7 million.", "verified": true}, {"document_id": "RMBL-PR-2023-05-10", "locator": "P0047", "quote": "Cash and Restricted Cash as of March 31, 2023 was approximately $61.8 million, and total debt was $376.8 million.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C03", "status": "compliant", "rationale": "Total available liquidity of $97.4\u202fmillion exceeds the $25\u202fmillion minimum, satisfying the liquidity covenant.", "evidence": [{"document_id": "RMBL-PR-2023-05-10", "locator": "P0048", "quote": "Total Available Liquidity, defined as unrestricted cash plus availability under floorplan credit facilities for inventory on hand at March 31, 2023, totaled approximately $97.4 million.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C04", "status": "insufficient_evidence", "rationale": "No disclosure indicates whether the quarterly financial statements were filed within the 60\u2011day deadline required by Section\u202f6.01(b).", "evidence": [{"document_id": "RMBL-PR-2023-05-10", "locator": "P0009", "quote": "IRVING, Texas \u2013 May 10, 2023 \u2013 RumbleOn, Inc. (NASDAQ: RMBL) (the \u201cCompany\u201d or \u201cRumbleOn\u201d), the nation's first technology-based powersports platform, today announced operational and financial results for the three months ended March 31, 2023.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C05", "status": "insufficient_evidence", "rationale": "No public information shows whether a compliance certificate was delivered together with the financial statements as required by Section\u202f6.02(a).", "evidence": [{"document_id": "RMBL-PR-2023-05-10", "locator": "P0009", "quote": "IRVING, Texas \u2013 May 10, 2023 \u2013 RumbleOn, Inc. (NASDAQ: RMBL) (the \u201cCompany\u201d or \u201cRumbleOn\u201d), the nation's first technology-based powersports platform, today announced operational and financial results for the three months ended March 31, 2023.", "verified": true}], "interpretation": "model", "package_version": "1.0"}, {"clause_id": "C06", "status": "insufficient_evidence", "rationale": "The press release contains no indication of a default that would trigger a notice requirement under Section\u202f6.03(a).", "evidence": [{"document_id": "RMBL-PR-2023-05-10", "locator": "P0009", "quote": "IRVING, Texas \u2013 May 10, 2023 \u2013 RumbleOn, Inc. (NASDAQ: RMBL) (the \u201cCompany\u201d or \u201cRumbleOn\u201d), the nation's first technology-based powersports platform, today announced operational and financial results for the three months ended March 31, 2023.", "verified": true}], "interpretation": "model", "package_version": "1.0"}], "warnings": []}
